# ==============================================================================
# MboFlow Environment Configuration Template (.env.example)
# Copy this file to .env before starting the application:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ==============================================================================

# Server Network Binding
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# SAFINUM Challenge Simulation Mode
# Keep true for development and challenge demonstration (no real money operations)
SIMULATION_MODE=true

# Cryptographic Action Guard Secret Key
# Change this to any 32+ character random string for local development / testing
MBOA_SECRET_KEY=mboflow_local_dev_secret_key_change_me_in_production_998877

# Data Directory for SQLite WAL database and local audit persistence
MBOA_DATA_DIR=./data

# Browser Automation SSRF Security Allowlist (optional, comma-separated domain list)
# Leave blank to allow any public HTTP/HTTPS URL, or specify domains to restrict
MBOA_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Optional External Provider API Keys (Leave blank for SAFINUM Challenge Simulation)
# ------------------------------------------------------------------------------
# MTN Mobile Money Open API (Cameroon)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# Orange Money WebPay API (Cameroon)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
